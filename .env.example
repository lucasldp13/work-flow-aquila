# ============================================================================
# Workflow Aquila — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA faça commit do .env.local (já está no .gitignore).
# ============================================================================

# --- Supabase -----------------------------------------------------------
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Chave de serviço (service_role) — NUNCA exponha no cliente/navegador.
# Usada apenas em código de servidor (rotas de API) para: enviar e registrar
# e-mails, gerar URLs assinadas de documentos privados e o painel admin.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Aplicação ------------------------------------------------------------
# URL pública da aplicação, usada para montar o link protegido enviado
# nos e-mails de notificação ao Jurídico.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E-mail (SMTP) ----------------------------------------------------------
# Qualquer provedor SMTP funciona (Amazon SES, SendGrid, Mailgun, Google
# Workspace, Outlook 365 etc.). Exemplo abaixo com Amazon SES.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASSWORD=sua-senha-smtp
EMAIL_FROM="Workflow Aquila <nao-responda@aquila.com.br>"
